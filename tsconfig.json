{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "esnext",
		"useDefineForClassFields": true,
		"module": "esnext",
		"moduleResolution": "node",
		"strict": true,
		"jsx": "preserve",
		"sourceMap": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"lib": ["esnext", "dom"],
		"paths": {
			"hyperparam": ["node_modules/hyperparam/lib/index.d.ts"],
			"~/*": ["web/src/*"]
		},
		"skipLibCheck": true
	},
	"include": [
		"tailwind.config.ts",
		"web/src/**/*.ts",
		"web/src/**/*.d.ts",
		"web/src/**/*.tsx",
		"web/src/**/*.vue"
	]
}
