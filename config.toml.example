# Lorana Tales 配置示例
# 环境变量会覆盖本文件中的同名配置。生产环境建议复制到
# /etc/scardice-story-painter/config.toml 后按实际域名和存储路径修改。

[server]
# HTTP 服务监听地址。
# "0.0.0.0" 表示监听所有网卡，适合容器或服务器部署；"127.0.0.1" 只允许本机访问，适合反向代理后端或本地开发。
host = "0.0.0.0"

# HTTP 服务监听端口。
# 改为 80/443 通常需要额外权限；反向代理部署时一般保持 3000，并由 Nginx/Caddy 转发。
port = 3000

# 是否信任 CDN/反代转发的客户端 IP、协议和域名请求头。
# true 时读取并校验 CF-Connecting-IP、True-Client-IP、Fastly-Client-IP、
# X-Real-IP、X-Client-IP、X-Forwarded-For、Forwarded: for= 等客户端 IP 头，
# 同时使用 X-Forwarded-Proto/X-Forwarded-Host 生成外部链接和安全 Cookie。
# 只有当前面的每一层代理都会覆盖这些头、不会把公网传入值直接放行时才设为 true；
# false 时完全忽略外部转发头，适合直连部署，也能避免客户端伪造 IP。
trust_proxy = false

# 只有请求的 TCP 对端地址命中这里时，才会读取转发头。不要填 0.0.0.0/0 或 ::/0。
# 单层本机 Nginx/Caddy 通常保留默认值；CDN 后还有独立反代时，填写该反代到本服务所用的真实出口网段。
trusted_proxy_cidrs = ["127.0.0.1/32", "::1/128"]

# 允许访问后端的 Host 头白名单。
# 列表外 Host 会返回 400，可防止 Host header poisoning 影响 CORS 和分享链接生成。
# 反代/CDN 部署时填写用户实际访问的域名，以及代理转发到源站时使用的 Host（如有不同）。
allowed_hosts = ["localhost", "127.0.0.1", "::1"]

# HTTPS 公网部署建议设为 31536000；本地 HTTP 或尚未确认 HTTPS 全站可用时保持 0。
hsts_max_age_seconds = 0

[auto_update]
# 仅官方 GitHub Release 包内生效；源码构建、fork 和缺少 OFFICIAL_BUILD.json 的包始终不会自动更新。
# test 跟随正式版与 Testify 测试版，stable 只跟随正式版，off 完全关闭。默认快速迭代测试通道。
channel = "test"
# 检查间隔不低于 60 秒。新包会先校验 GitHub 摘要、SHA-256、提交号和归档结构，
# 再在内部端口通过版本健康检查后无停机切流；切换后 30 秒内崩溃会回退旧工作进程。
check_interval_seconds = 300
# 新版本包的暂存目录；应放在持久磁盘，且不要与其他程序共用。
staging_path = "./data/updates"

[storage]
# SQLite 数据库路径。
# 相对路径会以项目根目录为基准；系统服务部署建议使用 /var/lib/scardice-story-painter/scardice.db，避免工作目录变化导致新建空库。
sqlite_path = "./data/scardice.db"

# 公共传统日志数据库的总容量硬上限，单位 MB。正文、数据库页、索引与保守行开销都会计入。
# 可用环境变量 MAX_LOG_STORAGE_MB 覆盖；账号云端工程与 CQ 资源各自使用独立额度。
max_total_mb = 4096

[editor]
# 裸路径 / 使用的默认编辑器：story（新版沉浸式）或 legacy（旧版）。
# /story 和 /legacy 始终可直接进入对应页面。
default_mode = "story"

# 是否开放新版沉浸式染色器。关闭后会隐藏新版入口，/story 也会回落到旧版。
enable_story_mode = true

[branding]
# 顶栏最右侧显示的网站标题。
site_title = "Lorana Tales"
# 在像素花 Logo 旁显示普通网站标题；窄屏会自动省略过长文本。
show_site_title = true
# 顶栏 Logo 的本地 PNG 或 SVG 路径；相对路径以项目目录为基准，留空使用内置图标。
logo_path = "./out/lorana-tales-mark.png"
# 浏览器图标的本地 ICO、PNG 或 SVG 路径；相对路径以项目目录为基准，留空使用前端默认图标。
favicon_path = "./out/favicon.ico"
# 经典提示与沉浸画布水印共用；留空可完全隐藏。
community_notice = "GitHub: https://github.com/Scardice/Lorana-Tales · QQ群：1080498667"

[avatar_providers]
# Discord 与 KOOK 用户资料接口都需要 Bot Token；Token 只在服务端使用，绝不会返回给前端。
# 开关关闭或 Token 留空时不会请求对应平台。也可使用 DISCORD_BOT_TOKEN / KOOK_BOT_TOKEN 环境变量。
discord_enabled = false
discord_bot_token = ""
kook_enabled = false
kook_bot_token = ""

[resource_cache]
# 是否在上传时归档 CQ 码中的图片、语音和附件资源。
# CQ 视频不会下载，只会在日志中保留“【视频】”占位，避免占满硬盘。
# 开启后服务会下载可信来源资源，替换日志中的上游 URL；关闭时日志保持原样。默认 false，避免未确认的带宽与磁盘占用。
enabled = false

# CQ 资源存储目录。相对路径以项目根目录为基准；不要与其他程序共用，缓存清理只会删除本功能生成的文件。
path = "./data/cq-resources"

# 可选：QQ 内置 CQ 表情资源目录。为避免把腾讯素材误标为 MIT，本项目不重新分发素材。
# 请将资源包解压后填写包含 faces/0/apng/0.png 这类路径的根目录；留空时 [CQ:face] 显示【图片】占位。
cq_face_path = ""

# CQ 资源的保留天数（从成功归档时开始计算）。超过此范围会在启动及后续上传时自动清理；日志本身的保留天数由 app.log_retention_days 单独控制。
retention_days = 60

# 单个资源的下载/保存上限，单位 MB。响应头或实际下载内容超过上限都会跳过该资源，不影响日志上传。
max_file_mb = 12

# 每份日志最多归档多少个 CQ 资源，防止恶意或异常日志占用过多网络、内存和磁盘。
max_resources_per_log = 40

# PNG/JPEG/WebP 图片重编码为 WebP 时的有损质量（1-100）。数值越低越省流量和磁盘，65 是兼顾文字与普通聊天图片的默认值；如果重编码反而更大，会保留原文件。
image_quality = 65
audio_bitrate_kbps = 128 # 语音上传和归档时转为 Ogg Opus；较小的原文件不会被反向放大
ffmpeg_path = "ffmpeg" # 使用系统 FFmpeg，不随 MIT 项目捆绑 GPL 二进制；可填写绝对路径

# 允许下载的上游域名，支持 *.example.com 后缀匹配。默认仅覆盖 QQ/Tencent 常见媒体域名；需要其他图床时显式加入，避免日志 URL 被用于服务端请求探测。
allowed_hosts = ["*.qq.com", "*.qlogo.cn", "*.qpic.cn", "*.gtimg.cn", "*.discordapp.com", "*.kookapp.cn", "*.kookcdn.com", "*.kaiheila.cn"]

# 是否允许 allowed_hosts 以外的任意公网地址。保持 false 更安全；true 时仍会拒绝内网、环回和链路本地地址，但不建议在不受信任上传环境开启。
allow_public_hosts = false

# 下载单个资源的超时时间，单位秒。超时资源会保留原上游链接，不影响本次日志上传。
download_timeout_seconds = 15

# 图片解码/FFmpeg/最高质量 Brotli 的并发上限。CPU 可以慢，但不要用高并发换速度。
max_concurrent_jobs = 2
# 图片解码前后的像素总数硬限制，防止体积很小但尺寸巨大的图片耗尽内存。
max_image_pixels = 40000000
# 整个 CQ 资源目录的硬盘配额，单位 MB；达到后拒绝新增但仍可读取和清理旧资源。
max_total_mb = 4096

[accounts]
# 可选账号与云端编辑功能总开关。关闭时不注册账号 API，也不会显示登录入口。
enabled = false
# 是否允许访客自行注册；关闭后管理员仍可在 /admin 创建用户。
registration_enabled = true
# 首次启用且数据库中没有管理员时，用这组一次性凭据创建初始管理员。
# 首次登录必须立即改成正式用户名、邮箱和密码；完成后本配置凭据无法再次登录。
initial_admin_username = "admin"
initial_admin_password = "change-this-initial-password"
# 可留空；首次登录会强制填写正式邮箱。若填写，仍需在首次登录确认或修改。
initial_admin_email = ""
default_group = "default"
admin_group = "admin"
# 用于 AES-256-GCM 加密日志源访问密钥，启用账号时必须设置至少 32 个随机字符。
# 可用 `openssl rand -base64 48` 生成；修改后旧工程中的加密源密钥将无法解密。
encryption_key = ""
session_days = 30
trusted_device_days = 90
# auto/lax、strict 或 none；跨站部署使用 none 时必须走 HTTPS。
cookie_same_site = "auto"
# 留空允许任意邮箱域；也可写 ["example.com", "school.edu"]。
allowed_email_domains = []
max_project_mb = 25
max_asset_mb = 12
max_effect_presets = 100 # 每个账号最多保存多少个自定义特效预设
# image（本地图片验证码）、altcha（自托管 PoW）、turnstile 或 hcaptcha。
captcha_provider = "image"
captcha_ttl_seconds = 120
risk_trust_minutes = 30
risk_cooldown_minutes = 15
email_code_ttl_minutes = 10
email_code_resend_seconds = 60
email_code_per_hour = 5
ip_email_code_per_hour = 10
# 单个来源网段每分钟最多发起多少次密码校验，防止昂贵 KDF 被用于耗尽内存。
password_attempts_per_minute = 20

# 账号组配额按工程压缩后的实际数据库占用计算；可继续添加自定义组。
# retention_days 按云端工程最后修改时间计算；0 表示永久保留。管理员可为单个用户覆盖。
[accounts.storage_groups.default]
quota_mb = 256
max_projects = 100
retention_days = 180

[accounts.storage_groups.advanced]
quota_mb = 2048
max_projects = 1000
retention_days = 365

# 管理员专用组。只有 role=admin 且属于该组的账户才能进入管理员面板。
[accounts.storage_groups.admin]
quota_mb = 8192
max_projects = 5000
retention_days = 0

[accounts.smtp]
host = ""
port = 587
secure = false
user = ""
password = ""
from = "Lorana Tales <no-reply@example.com>"
# 主题与正文都支持 {{code}}、{{username}}、{{nickname}}、{{site_title}}、
# {{logo_url}}（也可写 {{logo}}）、{{purpose}}、{{expires_minutes}} 占位符；
# 内置 HTML 还会使用 {{logo_block}} 输出安全的可选 Logo 图片标签。
subject_template = "{{site_title}} {{purpose}}验证码"
# 可直接在 TOML 中写模板；留空时使用内置的响应式 HTML 与纯文本版本。
text_template = ""
html_template = ""
# 也可以把正文放在单独的 .txt/.html/.htm 文件。相对路径以项目根目录为准；
# 配置文件路径后会优先于上面的内联正文。HTML 中的占位符会安全转义。
text_template_path = ""
html_template_path = ""

[accounts.altcha]
# 使用 ALTCHA 时设置独立随机 HMAC 密钥；留空会退回 accounts.encryption_key。
hmac_key = ""
max_number = 100000

[accounts.turnstile]
site_key = ""
secret_key = ""

[accounts.hcaptcha]
site_key = ""
secret_key = ""

[app]
# 生成日志查看链接时使用的前端地址。
# 留空时使用当前请求经 trust_proxy 解析后的外部协议和域名，适合前后端一体部署；
# 跨域部署、CDN 托管完整前端或反向代理多域名时，应固定为用户实际打开的公开前端 URL。
frontend_url = ""

# 日志保留天数。
# 上传后的后台清理和管理端手动清理都会按这个天数删除更旧记录；数值越小，存储占用越低但历史日志更早失效。
log_retention_days = 60

# 单次上传请求大小限制，单位 MB。
# 数值越大越能容纳大型日志，但也会提高内存、磁盘和带宽消耗；超过限制会直接返回 413。
max_upload_mb = 5

# 服务启动时是否立即清理一次过期日志。
# true 适合长期运行服务重启后快速回收空间；false 可避免启动阶段执行额外数据库写操作。
cleanup_on_start = false

# 每次上传成功后是否后台清理过期日志。
# true 可持续控制数据库体积；false 会减少上传后的后台任务，但需要管理员定期在后台手动清理。
cleanup_after_upload = true

# 备用上传 API 地址。
# 主库写入失败时会把日志转发到该地址；留空则主库失败时直接返回错误。多台服务可配置成级联备用链路。
backup_upload_api = ""

[admin]
# 仅在 accounts.enabled=false 时使用的旧式管理后台密码。
# 账号模式开启后此项完全忽略，管理后台只接受管理员账号会话。
password = ""

[metrics]
# 是否开启 /metrics。
# false 时 /metrics 返回 404；true 时输出 Prometheus 文本指标，建议只对内网或监控系统开放。
enabled = false

# /metrics Bearer token。
# enabled=true 时必须设置；缺失会拒绝启动，读取时必须带 Authorization: Bearer <token>。
token = ""

[security]
# 上传内容注入拦截开关。
# true 时会扫描 API 和前端上传的日志，命中 XSS/SQLi/SSTI/命令注入等危险片段会拒绝写库并记录审计日志；false 时仅保留基础上传校验。
injection_guard_enabled = true

# 安全审计日志路径。
# 注入拦截命中后会按 JSON Lines 追加记录 IP、接口、日志名、uniform_id、内容哈希、命中语句和上下文；相对路径以项目根目录为基准。
audit_log_path = "./data/security-audit.log"

# 安全拦截警告中的调笑语句数组。
# 命中拦截时会随机抽一条，并以“某人”为来源展示；留空时使用内置默认句。
warning_quotes = [
  "Hey bro, what the fuck are you doing? Stop dreaming about being a hacker, you low-tech noob! 👎👎👎 Wake up, the floor is freezing!",
]

# 管理后台疑似爆破临时封禁开关。
# true 时登录失败达到阈值会封禁来源 IP，并重定向到安全拦截页；false 时只按普通登录失败处理。
admin_bruteforce_block_enabled = true

# 爆破判定阈值，窗口期内失败次数达到该值后触发封禁。
# 数值越小越敏感，误封概率更高；数值越大越宽松。
admin_bruteforce_max_attempts = 8

# 爆破统计窗口，单位秒。
# 超过该时间未达到阈值会重置失败计数和凭据列表。
admin_bruteforce_window_seconds = 60

# 爆破触发后的临时封禁时长，单位秒。
# 封禁期间该 IP 访问普通页面/API 会被重定向到安全拦截页。
admin_bruteforce_block_seconds = 60
