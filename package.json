		"build:server": "tsc -p tsconfig.server.json && node scripts/set-executable.mjs dist/bin/scardice-story-painter.js",
		"build:web": "vue-tsc --noEmit && vite build",
		"test:story-format": "tsx scripts/verify-story-format.ts",
		"test:account-groups": "pnpm build:server && node scripts/verify-account-groups.mjs",
		"test:security": "tsx scripts/verify-security-boundaries.ts && tsx scripts/verify-live-deployment-security.ts && node scripts/verify-rolling-proxy-security.mjs && node scripts/verify-supply-chain.mjs",
		"test:pentest": "node scripts/verify-wsl-pentest.mjs",
		"tutorials:build": "tsx scripts/generate-tutorial-ssp.ts",
		"test:e2e": "pnpm build && playwright test",
		"lint": "tsc -p tsconfig.server.json --noEmit && vue-tsc --noEmit",
		"preview": "vite preview --host 0.0.0.0"
	},
